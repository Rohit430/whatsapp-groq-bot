// Import necessary libraries
const { useSingleFileAuthState, makeWASocket, DisconnectReason } = require('@whiskeysockets/baileys');
const fs = require('fs');
const path = require('path');

// Path to the auth file
const authFile = './auth_info.json'; // Make sure this file is accessible and persists across restarts

// Load the auth state
const { state, saveState } = useSingleFileAuthState(authFile);

// Check if the state is loaded correctly
if (!state || !state.creds || !state.creds.me) {
  console.error('Authentication state not loaded correctly.');
  process.exit(1);  // Exit if authentication is not valid
}

// Function to start the bot
